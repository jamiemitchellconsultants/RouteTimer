@using System.Globalization
@using RouteTimer.Client.Api
@using RouteTimer.Client.Components
@using RouteTimer.Contracts.Adjustments
@inject IRouteTimerApiClient Api

<div data-testid="time-target-editor">
    @if (Problem is not null)
    {
        <div data-testid="time-target-error">
            <ProblemMessage Problem="@Problem" FallbackMessage="We could not create the time target adjustment." />
        </div>
    }

    <div class="prediction-detail-grid">
        <div>
            <label for="time-target-duration">Target Duration (hh:mm:ss)</label>
            <input id="time-target-duration" data-testid="time-target-duration"
                   value="@TargetDurationText" @oninput="OnDurationInput" />
            @if (DurationError is not null)
            {
                <span class="prediction-detail-list" style="color: var(--danger-color, red);">@DurationError</span>
            }
        </div>
        <div class="time-target-climb-focus">
            <label for="time-target-climb-focus">
                Climb focus: <output for="time-target-climb-focus">@ClimbFocusLevel</output>
            </label>
            <input type="range" id="time-target-climb-focus" data-testid="time-target-climb-focus"
                   min="0" max="5" step="1" value="@ClimbFocusLevel"
                   aria-describedby="time-target-climb-focus-help"
                   @oninput="OnClimbFocusChanged" />
            <div class="time-target-climb-focus-scale" data-testid="time-target-climb-focus-scale" aria-hidden="true">
                <span>0 · Proportional</span>
                <span>5 · Climb focused</span>
            </div>
            <small id="time-target-climb-focus-help">
                Higher values shift more of the effort towards climbs.
            </small>
        </div>
        <div>
            <label for="time-target-feasibility">Include Feasibility Report</label>
            <input type="checkbox" id="time-target-feasibility" data-testid="time-target-feasibility"
                   checked="@IncludeFeasibility" @onchange="e => IncludeFeasibility = (bool)(e.Value ?? false)" />
        </div>
    </div>

    <div class="prediction-detail-actions">
        <button type="button" class="predictions-button"
                data-testid="time-target-submit"
                @onclick="SubmitAsync"
                disabled="@(isSubmitting || DurationError is not null)">
            Create time target adjustment
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid PredictionId { get; set; }

    [Parameter]
    public EventCallback<PredictionAdjustmentSubmissionResponse> OnCreated { get; set; }

    private string TargetDurationText { get; set; } = "01:00:00";
    private int ClimbFocusLevel { get; set; }
    private bool IncludeFeasibility { get; set; } = true;

    private ApiProblemException? Problem { get; set; }
    private bool isSubmitting;
    private string? DurationError { get; set; }

    protected override void OnInitialized()
    {
        ValidateDuration(TargetDurationText);
    }

    private void OnDurationInput(ChangeEventArgs e)
    {
        TargetDurationText = e.Value?.ToString() ?? "";
        ValidateDuration(TargetDurationText);
    }

    private void ValidateDuration(string text)
    {
        if (!TryParseDuration(text, out _))
        {
            DurationError = "Enter duration as hh:mm:ss between 00:00:01 and 48:00:00.";
        }
        else
        {
            DurationError = null;
        }
    }

    private void OnClimbFocusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var level) &&
            level is >= 0 and <= 5)
        {
            ClimbFocusLevel = level;
        }
    }

    private async Task SubmitAsync()
    {
        Problem = null;
        if (!TryParseDuration(TargetDurationText, out var totalSeconds))
        {
            DurationError = "Enter duration as hh:mm:ss between 00:00:01 and 48:00:00.";
            return;
        }

        var distribution = ClimbFocusLevel == 0 ? "proportional" : "climb-focused";
        double? climbBias = ClimbFocusLevel switch
        {
            0 => null,
            1 => 1.2,
            2 => 1.4,
            3 => 1.6,
            4 => 1.8,
            5 => 2.0,
            _ => null,
        };

        isSubmitting = true;
        try
        {
            var request = new TimeTargetRequest(
                totalSeconds,
                distribution,
                climbBias,
                IncludeFeasibility);

            var submission = await Api.CreatePredictionAdjustmentAsync(PredictionId, request, CancellationToken.None);
            await OnCreated.InvokeAsync(submission);
        }
        catch (ApiProblemException problem)
        {
            Problem = problem;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static bool TryParseDuration(string? value, out double totalSeconds)
    {
        totalSeconds = 0;
        var parts = value?.Split(':');
        if (parts is not { Length: 3 } || parts.Any(part => part.Length != 2) ||
            !int.TryParse(parts[0], NumberStyles.None, CultureInfo.InvariantCulture, out var hours) ||
            !int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var minutes) ||
            !int.TryParse(parts[2], NumberStyles.None, CultureInfo.InvariantCulture, out var seconds) ||
            hours is < 0 or > 48 || minutes is < 0 or > 59 || seconds is < 0 or > 59)
        {
            return false;
        }

        totalSeconds = (hours * 3600d) + (minutes * 60d) + seconds;
        return totalSeconds is >= 1 and <= 172800;
    }
}
