@using RouteTimer.Client.Formatting
@using RouteTimer.Contracts.Adjustments
@using RouteTimer.Contracts.Predictions

<section class="prediction-detail-panel" data-testid="adjustment-comparison">
    <h2>Comparison</h2>
    <button type="button" class="predictions-button predictions-button--secondary"
            data-testid="adjustment-back-to-baseline"
            @onclick="() => OnBackToBaseline.InvokeAsync()">
        Back to baseline
    </button>

    <table data-testid="adjustment-comparison-table">
        <thead>
            <tr>
                <th scope="col"></th>
                <th scope="col">Baseline</th>
                <th scope="col">@RouteTimerText.Sentence(Selected.Summary.StrategyType)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">Moving time</th>
                <td>@RouteTimerFormat.DetailedDuration(Baseline.MovingSeconds)</td>
                <td>@RouteTimerFormat.DetailedDuration(Selected.Summary.MovingSeconds)</td>
            </tr>
            <tr>
                <th scope="row">Average speed</th>
                <td>@RouteTimerFormat.SpeedKilometresPerHour(Baseline.AverageSpeedMetresPerSecond)</td>
                <td>@RouteTimerFormat.SpeedKilometresPerHour(Selected.Summary.AverageSpeedMetresPerSecond)</td>
            </tr>
            <tr>
                <th scope="row">Average power</th>
                <td>@RouteTimerFormat.Power(Baseline.AveragePowerWatts)</td>
                <td>@RouteTimerFormat.Power(Selected.Summary.AveragePowerWatts)</td>
            </tr>
        </tbody>
    </table>

    @if (Selected.Summary.Warnings.Count > 0)
    {
        <ul data-testid="adjustment-comparison-warnings" class="prediction-detail-list">
            @foreach (var warning in Selected.Summary.Warnings)
            {
                <li>@RouteTimerText.Sentence(warning)</li>
            }
        </ul>
    }

    @if (SegmentGainsReport is { } report)
    {
        <div data-testid="adjustment-comparison-segment-gains-report">
            <dl class="prediction-detail-grid">
                <div>
                    <dt>Matched segments</dt>
                    <dd>@report.GetProperty("matchedSegmentCount").GetInt32()</dd>
                </div>
                <div>
                    <dt>Unmatched segments</dt>
                    <dd>@report.GetProperty("unmatchedSegmentCount").GetInt32()</dd>
                </div>
            </dl>
            <ul class="prediction-detail-list" data-testid="adjustment-comparison-rule-hit-counts">
                @foreach (var hit in report.GetProperty("ruleHitCounts").EnumerateArray())
                {
                    <li>Rule @(hit.GetProperty("ruleIndex").GetInt32() + 1): @hit.GetProperty("segmentCount").GetInt32() segment(s)</li>
                }
            </ul>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public PredictionSummaryResponse Baseline { get; set; } = null!;

    [Parameter, EditorRequired]
    public PredictionAdjustmentDetailResponse Selected { get; set; } = null!;

    [Parameter]
    public EventCallback OnBackToBaseline { get; set; }

    // Every strategy report reaches this component as an opaque JsonElement (see Task 6's deviation
    // notes), so segment gains is the first to render its own report shape; later strategies get their
    // own switch arm here rather than a shared abstraction premised on reports no strategy has yet.
    private System.Text.Json.JsonElement? SegmentGainsReport =>
        Selected.Summary.StrategyType == "SegmentSpecificGains" ? Selected.Report : null;
}
