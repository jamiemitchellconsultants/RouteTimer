@using RouteTimer.Contracts.Adjustments

<section class="prediction-detail-panel" data-testid="adjustment-builder">
    <h2>Create adjustment</h2>

    @if (Capabilities is null || !Capabilities.Enabled)
    {
        <p data-testid="adjustment-builder-disabled">Pacing adjustments are not currently enabled.</p>
    }
    else if (EnabledStrategyNames.Count == 0)
    {
        <p data-testid="adjustment-builder-no-strategies">No pacing strategies are currently available.</p>
    }
    else
    {
        <p data-testid="adjustment-builder-available">Available strategies: @string.Join(", ", EnabledStrategyNames)</p>

        @if (Capabilities.SegmentSpecificGains)
        {
            <SegmentGainsEditor PredictionId="PredictionId" OnCreated="id => OnAdjustmentCreated.InvokeAsync(id)" />
        }

        @if (Capabilities.NpIfTarget)
        {
            <NpIfTargetEditor PredictionId="PredictionId" OnCreated="id => OnAdjustmentCreated.InvokeAsync(id)" />
        }

        @if (Capabilities.TimeTarget)
        {
            <TimeTargetEditor PredictionId="PredictionId" OnCreated="id => OnAdjustmentCreated.InvokeAsync(id)" />
        }

        @if (Capabilities.RpeZoneShift)
        {
            <ZoneShiftEditor PredictionId="PredictionId" OnCreated="id => OnAdjustmentCreated.InvokeAsync(id)" />
        }

        @if (Capabilities.VariableMatchBurning)
        {
            <MatchBurningEditor PredictionId="PredictionId" OnCreated="id => OnAdjustmentCreated.InvokeAsync(id)" />
        }
    }
</section>

@code {
    [Parameter]
    public PacingStrategyCapabilityResponse? Capabilities { get; set; }

    [Parameter]
    public Guid PredictionId { get; set; }

    [Parameter]
    public EventCallback<Guid> OnAdjustmentCreated { get; set; }

    private IReadOnlyList<string> EnabledStrategyNames => Capabilities is null
        ? []
        : new (bool Enabled, string Name)[]
            {
                (Capabilities.SegmentSpecificGains, "Segment-specific gains"),
                (Capabilities.NpIfTarget, "NP/IF target"),
                (Capabilities.TimeTarget, "Time target"),
                (Capabilities.RpeZoneShift, "RPE/zone shift"),
                (Capabilities.VariableMatchBurning, "Variable match-burning"),
            }
            .Where(entry => entry.Enabled)
            .Select(entry => entry.Name)
            .ToArray();
}
