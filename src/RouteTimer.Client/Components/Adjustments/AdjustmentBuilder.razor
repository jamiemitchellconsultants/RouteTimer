@using RouteTimer.Contracts.Adjustments

<section class="prediction-detail-panel" data-testid="adjustment-builder">
    <h2>Create adjustment</h2>

    @if (Capabilities is null || !Capabilities.Enabled)
    {
        <p data-testid="adjustment-builder-disabled">Pacing adjustments are not currently enabled.</p>
    }
    else if (EnabledStrategyNames.Count == 0)
    {
        <p data-testid="adjustment-builder-no-strategies">No pacing strategies are currently available.</p>
    }
    else
    {
        <p data-testid="adjustment-builder-available">Available strategies: @string.Join(", ", EnabledStrategyNames)</p>

        <div class="adjustment-strategy-grid" data-testid="adjustment-strategy-grid">
            @if (Capabilities.SegmentSpecificGains)
            {
                <section class="adjustment-strategy-card" data-testid="adjustment-card-segment-gains">
                    <h3>Segment-specific gains</h3>
                    <SegmentGainsEditor PredictionId="PredictionId" OnCreated="submission => OnAdjustmentCreated.InvokeAsync(submission)" />
                </section>
            }

            @if (Capabilities.NpIfTarget)
            {
                <section class="adjustment-strategy-card" data-testid="adjustment-card-np-if">
                    <h3>NP/IF target</h3>
                    <NpIfTargetEditor PredictionId="PredictionId" OnCreated="submission => OnAdjustmentCreated.InvokeAsync(submission)" />
                </section>
            }

            @if (Capabilities.TimeTarget)
            {
                <section class="adjustment-strategy-card" data-testid="adjustment-card-time-target">
                    <h3>Time target</h3>
                    <TimeTargetEditor PredictionId="PredictionId" OnCreated="submission => OnAdjustmentCreated.InvokeAsync(submission)" />
                </section>
            }

            @if (Capabilities.RpeZoneShift)
            {
                <section class="adjustment-strategy-card" data-testid="adjustment-card-zone-shift">
                    <h3>RPE/zone shift</h3>
                    <ZoneShiftEditor PredictionId="PredictionId" OnCreated="submission => OnAdjustmentCreated.InvokeAsync(submission)" />
                </section>
            }

            @if (Capabilities.VariableMatchBurning)
            {
                <section class="adjustment-strategy-card" data-testid="adjustment-card-match-burning">
                    <h3>Variable match-burning</h3>
                    <MatchBurningEditor PredictionId="PredictionId" OnCreated="submission => OnAdjustmentCreated.InvokeAsync(submission)" />
                </section>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public PacingStrategyCapabilityResponse? Capabilities { get; set; }

    [Parameter]
    public Guid PredictionId { get; set; }

    [Parameter]
    public EventCallback<PredictionAdjustmentSubmissionResponse> OnAdjustmentCreated { get; set; }

    private IReadOnlyList<string> EnabledStrategyNames => Capabilities is null
        ? []
        : new (bool Enabled, string Name)[]
            {
                (Capabilities.SegmentSpecificGains, "Segment-specific gains"),
                (Capabilities.NpIfTarget, "NP/IF target"),
                (Capabilities.TimeTarget, "Time target"),
                (Capabilities.RpeZoneShift, "RPE/zone shift"),
                (Capabilities.VariableMatchBurning, "Variable match-burning"),
            }
            .Where(entry => entry.Enabled)
            .Select(entry => entry.Name)
            .ToArray();
}
