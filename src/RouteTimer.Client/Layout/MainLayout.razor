@inherits LayoutComponentBase
@using RouteTimer.Client.Api
@using RouteTimer.Client.Auth
@inject ClientAuthConfig AuthConfig
@inject IRouteTimerApiClient Api
@inject NavigationManager Navigation

<div class="page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="page-shell">
        <header class="top-row">
            <p class="top-row__title">RouteTimer</p>

            <AuthorizeView>
                <Authorized>
                    <nav class="account-links" aria-label="Account">
                        @if (AuthConfig.IsLocal)
                        {
                            <button type="button" class="account-links__signout" @onclick="LocalLogoutAsync">Log out</button>
                        }
                        else
                        {
                            <a href="authentication/profile">Account</a>
                            <a href="authentication/logout">Log out</a>
                        }
                    </nav>
                </Authorized>
                <NotAuthorized>
                    @if (!AuthConfig.IsLocal)
                    {
                        <nav class="account-links" aria-label="Authentication">
                            <a href="authentication/login">Log in</a>
                        </nav>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <main id="main-content" tabindex="-1">
            <article class="content">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private async Task LocalLogoutAsync()
    {
        await Api.LocalLogoutAsync(CancellationToken.None);

        // A forced reload re-reads /api/auth/config and /api/auth/session from scratch on the next
        // boot, which is simpler than reaching for the framework's auth-state provider from here and
        // just as correct for a sign-out that has already succeeded server-side.
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
