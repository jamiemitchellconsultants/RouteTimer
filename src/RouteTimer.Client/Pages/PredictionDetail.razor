@page "/predictions/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using RouteTimer.Client.Api
@using RouteTimer.Client.Components
@using RouteTimer.Client.Formatting
@using RouteTimer.Contracts.Predictions
@inject IRouteTimerApiClient Api

<PageTitle>Prediction detail | RouteTimer</PageTitle>

<h1>Prediction detail</h1>
<p>Inspect the stored model snapshot, assumptions, and route metrics for one prediction.</p>

@if (isLoading)
{
    <p data-testid="prediction-detail-loading">Loading prediction...</p>
}
else if (problem is not null || fallbackProblem)
{
    <div data-testid="prediction-detail-error">
        <ProblemMessage Problem="@problem" FallbackMessage="We could not load the prediction detail." />
    </div>
}
else if (prediction is null)
{
    <div data-testid="prediction-detail-not-found" class="prediction-detail-panel">
        <p>This prediction was not found.</p>
        <a href="/predictions">Back to predictions</a>
    </div>
}
else
{
    <section class="prediction-detail-panel">
        @if (orderedSegments.Count > 0)
        {
            <div class="prediction-detail-actions">
                <a data-testid="prediction-download-gpx"
                   class="predictions-button predictions-button--secondary"
                   href="@($"/api/predictions/{Id}/gpx")">Download GPX</a>
                <a data-testid="prediction-download-gpx-timed"
                   class="predictions-button predictions-button--secondary"
                   href="@($"/api/predictions/{Id}/gpx?timed=true")">Download GPX with predicted times</a>
            </div>

            @if (paceTrackerEnabled)
            {
                <div class="prediction-detail-actions">
                    <button type="button"
                            class="predictions-button predictions-button--secondary"
                            data-testid="prediction-open-pacetracker"
                            @onclick="CreateRoutePacerHandoffAsync"
                            disabled="@creatingHandoff">
                        @(creatingHandoff ? "Creating code…" : "Open in PaceTracker")
                    </button>
                </div>

                @if (creatingHandoff)
                {
                    <p data-testid="prediction-pacetracker-creating">Creating a PaceTracker code…</p>
                }

                @if (handoffProblem is not null || handoffFallbackProblem)
                {
                    <div data-testid="prediction-pacetracker-error">
                        <ProblemMessage Problem="@handoffProblem"
                                        FallbackMessage="We could not create a PaceTracker code. Download the timed GPX instead." />
                    </div>
                }

                @if (handoff is not null)
                {
                    <PaceTrackerHandoff Handoff="handoff"
                                        RoutePacerOrigin="@paceTrackerOrigin"
                                        TimedGpxDownloadUrl="@($"/api/predictions/{Id}/gpx?timed=true")"
                                        OnRecreate="CreateRoutePacerHandoffAsync"
                                        OnClose="CloseRoutePacerHandoff" />
                }
            }

            <p>
                If Garmin Connect rejects a manually uploaded GPX file, try uploading it as an
                activity instead of a course, then save that activity as a course — this works
                around upload errors some GPX importers report for course uploads.
            </p>

            <div class="prediction-detail-actions">
                <label>
                    Garmin activity type
                    <select data-testid="prediction-garmin-activity-type" @bind="garminActivityType">
                        <option value="road_biking">Road cycling</option>
                        <option value="cycling">Cycling</option>
                        <option value="gravel_cycling">Gravel</option>
                        <option value="mountain_biking">Mountain biking</option>
                    </select>
                </label>

                @if (prediction!.Summary.GarminCourseId is { } courseId)
                {
                    <a data-testid="prediction-garmin-course-link"
                       class="predictions-button predictions-button--secondary"
                       href="@($"https://connect.garmin.com/modern/course/{courseId}")"
                       target="_blank" rel="noopener noreferrer">View on Garmin Connect</a>

                    @if (!confirmingGarminResend)
                    {
                        <button type="button" data-testid="prediction-send-to-garmin-again"
                                class="predictions-button predictions-button--secondary"
                                @onclick="() => confirmingGarminResend = true"
                                disabled="@sendingToGarmin">Send to Garmin again</button>
                    }
                    else
                    {
                        <p>Sending again creates a second course on Garmin Connect. Continue?</p>
                        <button type="button" data-testid="prediction-send-to-garmin-confirm"
                                class="predictions-button predictions-button--danger"
                                @onclick="SendToGarminAsync"
                                disabled="@sendingToGarmin">Confirm</button>
                        <button type="button" data-testid="prediction-send-to-garmin-cancel"
                                class="predictions-button predictions-button--secondary"
                                @onclick="() => confirmingGarminResend = false"
                                disabled="@sendingToGarmin">Cancel</button>
                    }
                }
                else
                {
                    <button type="button" data-testid="prediction-send-to-garmin"
                            class="predictions-button predictions-button--secondary"
                            @onclick="SendToGarminAsync"
                            disabled="@sendingToGarmin">
                        @(sendingToGarmin ? "Sending…" : "Send to Garmin")
                    </button>
                }

                @if (garminCourseProblem is not null || garminCourseFallbackProblem)
                {
                    <div data-testid="prediction-garmin-course-error">
                        <ProblemMessage Problem="@garminCourseProblem" FallbackMessage="We could not send this prediction to Garmin." />
                    </div>
                }
            </div>
        }

        <dl data-testid="prediction-detail-summary" class="prediction-detail-grid">
            <div>
                <dt>Prediction ID</dt>
                <dd>@prediction.Summary.Id</dd>
            </div>
            <div>
                <dt>Model ID</dt>
                <dd>@prediction.Summary.ModelId</dd>
            </div>
            <div>
                <dt>State</dt>
                <dd>@RouteTimerText.Sentence(prediction.Summary.State)</dd>
            </div>
            <div>
                <dt>Confidence</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(prediction.Summary.Confidence))
                    {
                        <ConfidenceBadge Confidence="@prediction.Summary.Confidence" />
                    }
                    else
                    {
                        <span>Unavailable</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Distance</dt>
                <dd>@DisplayMetric(RouteTimerFormat.Distance(prediction.Summary.DistanceMetres))</dd>
            </div>
            <div>
                <dt>Ascent</dt>
                <dd>@DisplayMetric(RouteTimerFormat.Ascent(prediction.Summary.AscentMetres))</dd>
            </div>
            <div>
                <dt>Moving time</dt>
                <dd>@DisplayMetric(RouteTimerFormat.DetailedDuration(prediction.Summary.MovingSeconds))</dd>
            </div>
            <div>
                <dt>Average speed</dt>
                <dd>@DisplayMetric(RouteTimerFormat.SpeedKilometresPerHour(prediction.Summary.AverageSpeedMetresPerSecond))</dd>
            </div>
            <div>
                <dt>Average power</dt>
                <dd>@DisplayMetric(RouteTimerFormat.Power(prediction.Summary.AveragePowerWatts))</dd>
            </div>
            <div>
                <dt>Model version</dt>
                <dd>@prediction.Summary.ModelVersion</dd>
            </div>
            <div>
                <dt>Calibrated model</dt>
                <dd>@DisplayBoolean(prediction.Summary.ModelWasCalibrated)</dd>
            </div>
            <div>
                <dt>Validation state</dt>
                <dd>@RouteTimerText.Sentence(prediction.Summary.ValidationStatus)</dd>
            </div>
            <div>
                <dt>Median validation error</dt>
                <dd>@DisplayMetric(RouteTimerFormat.Percentage(prediction.Summary.ValidationMedianAbsolutePercentageError))</dd>
            </div>
            <div>
                <dt>P90 validation error</dt>
                <dd>@DisplayMetric(RouteTimerFormat.Percentage(prediction.Summary.ValidationP90AbsolutePercentageError))</dd>
            </div>
            <div>
                <dt>Rider weight</dt>
                <dd>@RouteTimerFormat.Weight(prediction.Summary.RiderWeightKg)</dd>
            </div>
            <div>
                <dt>Bike and equipment</dt>
                <dd>@RouteTimerFormat.Weight(prediction.Summary.BikeWeightKg)</dd>
            </div>
            <div>
                <dt>Surface</dt>
                <dd>@RouteTimerText.Sentence(prediction.Summary.SurfaceAssumption)</dd>
            </div>
            <div>
                <dt>Wind</dt>
                <dd>@RouteTimerText.Sentence(prediction.Summary.WindAssumption)</dd>
            </div>
            <div>
                <dt>Weather</dt>
                <dd>@RouteTimerText.Sentence(prediction.Summary.WeatherAssumption)</dd>
            </div>
            <div>
                <dt>Moving only</dt>
                <dd>@DisplayBoolean(prediction.Summary.MovingOnlyAssumption)</dd>
            </div>
            <div>
                <dt>Created</dt>
                <dd>@RouteTimerFormat.Timestamp(prediction.Summary.CreatedAt)</dd>
            </div>
            <div>
                <dt>Completed</dt>
                <dd>@DisplayMetric(RouteTimerFormat.Timestamp(prediction.Summary.CompletedAt))</dd>
            </div>
        </dl>
    </section>

    <section class="prediction-detail-panel">
        <h2>Warnings</h2>
        @if (prediction.Summary.Warnings.Count == 0)
        {
            <p>None</p>
        }
        else
        {
            <ul data-testid="prediction-detail-warnings" class="prediction-detail-list">
                @foreach (var warning in prediction.Summary.Warnings)
                {
                    <li>@RouteTimerText.Sentence(warning)</li>
                }
            </ul>
        }
    </section>

    <section class="prediction-detail-panel">
        <h2>Visualization status</h2>

        @if (segmentsReceivedOutOfOrder)
        {
            <p data-testid="prediction-detail-order-warning" class="prediction-detail-warning">
                Prediction segments arrived out of order and were sorted for visualization.
            </p>
        }

        @if (visualizationReady)
        {
            <div data-testid="prediction-detail-visualization">
                <PredictionVisualization Segments="orderedSegments" />
            </div>
        }
        else
        {
            <p data-testid="prediction-detail-visualization-pending">
                Visualization becomes available after the prediction succeeds with stored route segments.
            </p>
        }
    </section>
}

@code {
    private readonly CancellationTokenSource pageCancellation = new();
    private PredictionDetailResponse? prediction;
    private IReadOnlyList<PredictionSegmentResponse> orderedSegments = [];
    private ApiProblemException? problem;
    private bool fallbackProblem;
    private bool isLoading = true;
    private bool segmentsReceivedOutOfOrder;
    private bool visualizationReady;
    private string garminActivityType = "road_biking";
    private bool sendingToGarmin;
    private bool confirmingGarminResend;
    private ApiProblemException? garminCourseProblem;
    private bool garminCourseFallbackProblem;
    private bool paceTrackerEnabled;
    private string paceTrackerOrigin = string.Empty;
    private RoutePacerHandoffResponse? handoff;
    private bool creatingHandoff;
    private ApiProblemException? handoffProblem;
    private bool handoffFallbackProblem;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        problem = null;
        fallbackProblem = false;
        orderedSegments = [];
        segmentsReceivedOutOfOrder = false;
        visualizationReady = false;
        paceTrackerEnabled = false;
        paceTrackerOrigin = string.Empty;
        handoff = null;
        handoffProblem = null;
        handoffFallbackProblem = false;

        try
        {
            prediction = await Api.GetPredictionAsync(Id, pageCancellation.Token);
            if (prediction is not null)
            {
                orderedSegments = prediction.Segments.OrderBy(segment => segment.Sequence).ToArray();
                segmentsReceivedOutOfOrder = prediction.Segments
                    .Select(segment => segment.Sequence)
                    .SequenceEqual(orderedSegments.Select(segment => segment.Sequence)) is false;
                visualizationReady = prediction.Summary.State.Equals("Succeeded", StringComparison.OrdinalIgnoreCase)
                    && orderedSegments.Count > 0;
                await LoadRoutePacerStatusAsync();
            }
        }
        catch (ApiProblemException apiProblem)
        {
            problem = apiProblem;
            prediction = null;
        }
        catch (HttpRequestException)
        {
            fallbackProblem = true;
            prediction = null;
        }
        catch (OperationCanceledException) when (pageCancellation.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (!pageCancellation.IsCancellationRequested)
            {
                isLoading = false;
            }
        }
    }

    public void Dispose()
    {
        pageCancellation.Cancel();
        pageCancellation.Dispose();
    }

    private async Task SendToGarminAsync()
    {
        if (sendingToGarmin || prediction is null)
        {
            return;
        }

        sendingToGarmin = true;
        garminCourseProblem = null;
        garminCourseFallbackProblem = false;

        try
        {
            var created = await Api.CreateGarminCourseAsync(
                Id,
                new CreateGarminCourseRequest(null, garminActivityType),
                pageCancellation.Token);

            prediction = prediction with
            {
                Summary = prediction.Summary with
                {
                    GarminCourseId = created.CourseId,
                    GarminCourseUploadedAt = DateTimeOffset.UtcNow
                }
            };
            confirmingGarminResend = false;
        }
        catch (ApiProblemException apiProblem)
        {
            garminCourseProblem = apiProblem;
        }
        catch (HttpRequestException)
        {
            garminCourseFallbackProblem = true;
        }
        catch (OperationCanceledException) when (pageCancellation.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (!pageCancellation.IsCancellationRequested)
            {
                sendingToGarmin = false;
            }
        }
    }

    // Fail closed, and only for a prediction that actually has a route to send. A status call that
    // fails leaves the integration hidden rather than offering an action that cannot work -- and
    // deliberately touches nothing else, so a RoutePacer outage cannot blank the prediction,
    // the downloads, the visualization, or the Garmin controls.
    private async Task LoadRoutePacerStatusAsync()
    {
        if (orderedSegments.Count == 0)
        {
            return;
        }

        try
        {
            var status = await Api.GetRoutePacerStatusAsync(pageCancellation.Token);
            if (status.Enabled
                && Uri.TryCreate(status.RoutePacerOrigin, UriKind.Absolute, out var origin)
                && origin.Scheme == Uri.UriSchemeHttps)
            {
                paceTrackerEnabled = true;
                // Stored as the parsed origin, not the raw string: this is the value every
                // handoff link is validated against before it becomes a scannable code.
                paceTrackerOrigin = origin.GetLeftPart(UriPartial.Authority);
            }
        }
        catch (ApiProblemException)
        {
        }
        catch (HttpRequestException)
        {
        }
        catch (OperationCanceledException) when (pageCancellation.IsCancellationRequested)
        {
        }
    }

    private async Task CreateRoutePacerHandoffAsync()
    {
        if (creatingHandoff || prediction is null)
        {
            return;
        }

        creatingHandoff = true;
        // Cleared before the request, not after it: a stale code left on screen during a recreate
        // is one a rider could scan into a payload that is about to be replaced.
        handoff = null;
        handoffProblem = null;
        handoffFallbackProblem = false;

        try
        {
            handoff = await Api.CreateRoutePacerHandoffAsync(Id, pageCancellation.Token);
        }
        catch (ApiProblemException apiProblem)
        {
            handoffProblem = apiProblem;
        }
        catch (HttpRequestException)
        {
            handoffFallbackProblem = true;
        }
        catch (OperationCanceledException) when (pageCancellation.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (!pageCancellation.IsCancellationRequested)
            {
                creatingHandoff = false;
            }
        }
    }

    // Local dismissal only. The relay payload is single-use and expires on its own, and RouteTimer
    // has no endpoint that could revoke it early.
    private void CloseRoutePacerHandoff()
    {
        handoff = null;
        handoffProblem = null;
        handoffFallbackProblem = false;
    }

    private static string DisplayBoolean(bool value) => value ? "Yes" : "No";

    private static string DisplayMetric(string value) =>
        value == "—" ? "Unavailable" : value;
}
